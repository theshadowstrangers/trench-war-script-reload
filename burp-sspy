local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()

    if method == "FireServer" and hookRemoteEvent and self.ClassName == "RemoteEvent" then
        if interceptActive and self.Name == interceptTargetName then
            addLog("BLOCKED", self.Name, "Intercept blocked FireServer", Color3.fromRGB(255, 80, 80))
            return
        end
        if #noteQueue < MAX_EVENTS then
            table.insert(noteQueue, {
                name = self.Name, event = self, args = {...}, isFunction = false, kind = "RemoteEvent"
            })
        end
        if monitorActive then
            addLog("FireServer", self.Name, "Path: " .. buildPath(self), Color3.fromRGB(200, 140, 80))
        end
    elseif method == "InvokeServer" and hookRemoteFunction and self.ClassName == "RemoteFunction" then
        if interceptActive and self.Name == interceptTargetName then
            addLog("BLOCKED", self.Name, "Intercept blocked InvokeServer", Color3.fromRGB(255, 80, 80))
            return nil
        end
        if #noteQueue < MAX_EVENTS then
            table.insert(noteQueue, {
                name = self.Name, event = self, args = {...}, isFunction = true, kind = "RemoteFunction"
            })
        end
        if monitorActive then
            addLog("InvokeServer", self.Name, "Path: " .. buildPath(self), Color3.fromRGB(160, 100, 200))
        end
        -- Логируем ответ
        local result = oldNamecall(self, ...)
        if monitorActive then
            addLog("InvokeReply", self.Name, "Result: " .. fmt(result), Color3.fromRGB(100, 200, 160))
        end
        return result
    end

    return oldNamecall(self, ...)
end)

setreadonly(mt, true)

