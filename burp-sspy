        rightText = rightText,
        FireBtn = FireBtn,
        CopyBtn = CopyBtn,
        SpamBtn = SpamBtn,
        ClearBtn = ClearBtn,
        BlockBtn = BlockBtn,
        UnblockBtn = UnblockBtn,
        CopyInfoBtn = CopyInfoBtn,
        searchBox = searchBox,
        findBtn = findBtn,
