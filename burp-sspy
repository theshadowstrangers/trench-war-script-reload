local function hookIncomingEvent(instance)
    if instance.ClassName == "RemoteEvent" then
        pcall(function()
            instance.OnClientEvent:Connect(function(...)
                if not hookIncoming then return end
                if interceptActive and instance.Name == interceptTargetName then return end
                if #noteQueue < MAX_EVENTS then
                    table.insert(noteQueue, {
                        name = instance.Name, event = instance, args = {...}, isFunction = false, kind = "IncomingEvent"
                    })
                end
                if monitorActive then
                    addLog("Incoming", instance.Name, "Path: " .. buildPath(instance), Color3.fromRGB(80, 160, 220))
                end
            end)
        end)
    elseif instance.ClassName == "RemoteFunction" then
        pcall(function()
            local oldCallback = instance.OnClientInvoke
            if type(oldCallback) ~= "function" then
                instance.OnClientInvoke = function(...)
                    if not hookIncoming then return end
                    if interceptActive and instance.Name == interceptTargetName then return end
                    if #noteQueue < MAX_EVENTS then
                        table.insert(noteQueue, {
                            name = instance.Name, event = instance, args = {...}, isFunction = true, kind = "IncomingFunction"
                        })
                    end
                    if monitorActive then
                        addLog("IncomingFunc", instance.Name, "Path: " .. buildPath(instance), Color3.fromRGB(80, 200, 160))
                    end
                end
            end
        end)
    end
end

