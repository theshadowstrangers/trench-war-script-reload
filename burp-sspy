-- ==================== EXECUTE ====================
local function executeEventObject(e)
    if not e or not e.event or not e.event.Parent then return false end
    pcall(function()
        if e.kind == "IncomingEvent" then
            if e.event.ClassName == "RemoteEvent" then
                for _, conn in ipairs(getconnections(e.event.OnClientEvent)) do
                    conn:Fire(unpack(e.args))
                end
            end
        elseif e.kind == "IncomingFunction" then
            if type(e.event.OnClientInvoke) == "function" then
                e.event.OnClientInvoke(unpack(e.args))
            end
        elseif e.isFunction then
            e.event:InvokeServer(unpack(e.args))
        else
            e.event:FireServer(unpack(e.args))
        end
    end)
    return true
end

